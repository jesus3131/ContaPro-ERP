# ContaPro ERP - Environment Variables
# Copy this file to .env and fill in your values

# App
SECRET_KEY=change-this-to-a-random-secret-key

# Database
POSTGRES_SERVER=localhost
POSTGRES_USER=contapro
POSTGRES_PASSWORD=contapro123
POSTGRES_DB=contapro_erp

# Redis
REDIS_URL=redis://localhost:6379/0

# OpenAI
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4

# DIAN
DIAN_API_URL=
DIAN_API_KEY=
DIAN_TEST_MODE=true

# AWS (Optional)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_BUCKET_NAME=

# Frontend
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
